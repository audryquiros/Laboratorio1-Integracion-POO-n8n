      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result",
              "name": "resultado",
              "value": "={{ $json.error ? 'Revisar error de conexión o datos' : 'Factura procesada; revisar historial para detalle' }}",
              "type": "string"
            },
            {
              "id": "id",
              "name": "facturaId",
              "value": "={{ $json.facturaId || $json.id || 'No disponible' }}",
              "type": "string"
            },
            {
              "id": "trend",
              "name": "tendencia",
              "value": "={{ $json.tendencia || 'Ver historial' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "final",
      "name": "Resultado final",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2000,
        300
      ]
    }
