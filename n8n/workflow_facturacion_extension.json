{
  "name": "Laboratorio 1 Extension - Facturacion POO + n8n",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Iniciar revisión",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:3000/invoices?estado=pendiente",
        "options": {
          "timeout": 10000
        }
      },
      "id": "get-invoices",
      "name": "Obtener facturas pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "https://date.nager.at/api/v3/PublicHolidays/2026/CR",
        "options": {
          "timeout": 10000
        }
      },
      "id": "get-holidays",
      "name": "Consultar feriados Nager.Date",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).flat();\nreturn [{json:{feriados:rows.filter(x=>x && x.date)}}];"
      },
      "id": "normalize-holidays",
      "name": "Normalizar feriados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://worldtimeapi.org/api/timezone/America/Costa_Rica",
        "options": {
          "timeout": 10000
        }
      },
      "id": "get-time",
      "name": "Consultar fecha/hora Costa Rica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        500
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const x=$input.first()?.json||{}; const currentDate=(x.datetime||'').slice(0,10)||new Date().toISOString().slice(0,10); return [{json:{currentDate,source:x.datetime?'WorldTimeAPI':'fallback-local'}}];"
      },
      "id": "normalize-time",
      "name": "Normalizar fecha/hora",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        500
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "merge-apis",
      "name": "Merge: feriados + fecha/hora",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        680,
        400
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:3000/historial",
        "options": {
          "timeout": 10000
        }
      },
      "id": "get-history",
      "name": "Obtener historial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const invoices = $('Obtener facturas pendientes').all().map(x => x.json);\nconst merged = $input.first()?.json ?? {};\nconst holidayRows = $('Normalizar feriados').first()?.json?.feriados ?? [];\nconst holidays = new Set(holidayRows.map(h => h.date).filter(Boolean));\nconst now = merged.currentDate || new Date().toISOString().slice(0,10);\nconst oldHistory = $('Obtener historial').all().map(x => x.json).filter(x => x && x.id !== undefined);\nconst overdueCount = oldHistory.filter(h => h.estadoCalculado === 'vencida' || h.estado === 'vencida').length;\nconst trend = oldHistory.length < 2 ? 'Sin historial suficiente' : (overdueCount > oldHistory.length/2 ? 'Empeorando: predominan facturas vencidas' : 'Estable o mejorando: no predominan facturas vencidas');\n\nfunction isBusinessDay(iso) {\n const d = new Date(`${iso}T12:00:00Z`);\n return d.getUTCDay() !== 0 && d.getUTCDay() !== 6 && !holidays.has(iso);\n}\nfunction addBusinessDays(start, count) {\n if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(start)) throw new Error('Fecha de emisión inválida; use YYYY-MM-DD.');\n if (!Number.isInteger(Number(count)) || Number(count) < 0) throw new Error('Plazo inválido.');\n const d = new Date(`${start}T12:00:00Z`); let n=0, guard=0;\n while(n < Number(count)) { d.setUTCDate(d.getUTCDate()+1); const iso=d.toISOString().slice(0,10); if(isBusinessDay(iso)) n++; if(++guard>800) throw new Error('Límite de cálculo excedido.'); }\n return d.toISOString().slice(0,10);\n}\nreturn invoices.map(f => {\n try {\n  if(f.id===undefined || !f.cliente || !f.fechaEmision) throw new Error('Faltan id, cliente o fechaEmision.');\n  const type=String(f.tipo || 'credito').toLowerCase();\n  // Equivalente polimórfico a FacturaCredito / FacturaContado.\n  let due;\n  if(type==='contado') due=f.fechaEmision;\n  else {\n   const plazo=f.diasPlazo===undefined || f.diasPlazo===null ? 15 : Number(f.diasPlazo);\n   if(!Number.isInteger(plazo)||plazo<1) throw new Error('El plazo de crédito debe ser entero positivo.');\n   due=addBusinessDays(f.fechaEmision,plazo);\n  }\n  const existing=String(f.estado||'pendiente').toLowerCase();\n  const state=['pagada','anulada'].includes(existing)?existing:(now>due?'vencida':'pendiente');\n  return {json:{...f, tipo:type, fechaVencimiento:due, estadoCalculado:state, fechaProceso:now, tendencia:trend, error:null}};\n } catch(e) { return {json:{...f, estadoCalculado:'error', fechaProceso:now, tendencia:trend, error:e.message}}; }\n});"
      },
      "id": "calculate",
      "name": "Calcular con herencia y tendencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-overdue",
              "leftValue": "={{ $json.estadoCalculado }}",
              "rightValue": "vencida",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-overdue",
      "name": "¿Factura vencida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://127.0.0.1:3000/invoices/{{ $json.id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ estado: $json.estadoCalculado, fechaVencimiento: $json.fechaVencimiento, ultimaRevision: $json.fechaProceso }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "patch-invoice",
      "name": "Actualizar factura vencida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        180
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "laboratorio@example.com",
        "toEmail": "={{ $json.email || 'CAMBIAR_DESTINATARIO' }}",
        "subject": "=Aviso: factura vencida #{{ $json.id }}",
        "emailFormat": "text",
        "text": "=La factura #{{ $json.id }} del cliente {{ $json.cliente }} está vencida. Fecha de vencimiento: {{ $json.fechaVencimiento }}. Tendencia: {{ $json.tendencia }}.",
        "options": {}
      },
      "id": "email-send",
      "name": "Enviar aviso de factura vencida",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1560,
        180
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/historial",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ facturaId: $json.id, cliente: $json.cliente, estadoCalculado: $json.estadoCalculado, fechaVencimiento: $json.fechaVencimiento || null, fechaProceso: $json.fechaProceso, tendencia: $json.tendencia, tipo: $json.tipo, error: $json.error || null }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "post-history-overdue",
      "name": "Guardar historial (vencida)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        180
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/historial",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ facturaId: $json.id, cliente: $json.cliente, estadoCalculado: $json.estadoCalculado, fechaVencimiento: $json.fechaVencimiento || null, fechaProceso: $json.fechaProceso, tendencia: $json.tendencia, tipo: $json.tipo, error: $json.error || null }) }}",
