    {
      "parameters": {
        "jsCode": "const facturasRaw = $('Obtener facturas pendientes').all().map(x => x.json);\nconst datosFecha = $('Unir feriados y fecha actual').first().json;\nconst feriados = new Set(datosFecha.feriados || []);\nconst hoy = datosFecha.fecha;\n\nfunction esHabil(iso) {\n  const d = new Date(`${iso}T12:00:00Z`);\n  return d.getUTCDay() !== 0 && d.getUTCDay() !== 6 && !feriados.has(iso);\n}\nfunction sumarDiasHabiles(inicio, cantidad) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(inicio)) throw new Error('Fecha de emisión ausente o inválida (YYYY-MM-DD).');\n  if (!Number.isInteger(Number(cantidad)) || Number(cantidad) < 1) throw new Error('diasPlazo debe ser entero positivo.');\n  const d = new Date(`${inicio}T12:00:00Z`);\n  let n = 0, guardia = 0;\n  while (n < Number(cantidad)) {\n    d.setUTCDate(d.getUTCDate() + 1);\n    const iso = d.toISOString().slice(0,10);\n    if (esHabil(iso)) n++;\n    if (++guardia > 800) throw new Error('Límite de cálculo excedido.');\n  }\n  return d.toISOString().slice(0,10);\n}\nconst resultado = [];\nfor (const f of facturasRaw) {\n  try {\n    if (f.id === undefined || !f.cliente || !f.fechaEmision) throw new Error('Faltan id, cliente o fechaEmision.');\n\nlet vencimiento;\n\nconst tipo = String(f.tipo || 'credito').toLowerCase();\n\nif (tipo === 'contado') {\n  vencimiento = f.fechaEmision;\n} else {\n  vencimiento = sumarDiasHabiles(\n    f.fechaEmision,\n    f.diasPlazo ?? 15\n  );\n}\n    const estado = ['pagada','anulada'].includes(String(f.estado).toLowerCase())\n      ? String(f.estado).toLowerCase()\n      : (hoy > vencimiento ? 'vencida' : 'pendiente');\n    resultado.push({json:{...f, fechaVencimiento:vencimiento, estadoCalculado:estado, fechaProceso:hoy, error:null}});\n  } catch (e) {\n    resultado.push({json:{...f, estadoCalculado:'error', error:e.message, fechaProceso:hoy}});\n  }\n}\nreturn resultado;"
      },
