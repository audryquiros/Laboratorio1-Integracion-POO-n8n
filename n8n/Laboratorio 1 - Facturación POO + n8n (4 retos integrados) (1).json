    {
      "parameters": {
        "jsCode": "\nconst historial = $('Consultar historial').all().map(item => item.json);\n\nconst hoy = $now.setZone('America/Costa_Rica').toISODate();\n\n// Conservamos la revisión más reciente de cada factura.\nconst porFactura = new Map();\n\nfor (const item of historial) {\n  const id = String(item.facturaId ?? item.id ?? '');\n  if (!id) continue;\n\n  const anterior = porFactura.get(id);\n\n  if (\n    !anterior ||\n    String(item.fechaRevision ?? '') >\n      String(anterior.fechaRevision ?? '')\n  ) {\n    porFactura.set(id, item);\n  }\n}\n\nconst facturas = [...porFactura.values()];\n\nconst vencidasHoy = facturas.filter(item =>\n  String(item.estado ?? '').toLowerCase() === 'vencida'\n).length;\n\nconst vencidasAnterior = historial.filter(item =>\n  String(item.estado ?? '').toLowerCase() === 'vencida' &&\n  String(item.fechaRevision ?? '') < hoy\n).length;\n\nlet tendencia = 'Sin datos suficientes para comparar';\n\nif (historial.length > 0) {\n  if (vencidasHoy > vencidasAnterior) {\n    tendencia = 'Aumentaron las facturas vencidas';\n  } else if (vencidasHoy < vencidasAnterior) {\n    tendencia = 'Disminuyeron las facturas vencidas';\n  } else {\n    tendencia = 'Las facturas vencidas se mantienen';\n  }\n}\n\nreturn [{\n  json: {\n    fechaAnalisis: hoy,\n    totalRegistros: historial.length,\n    facturasUnicas: facturas.length,\n    vencidasActuales: vencidasHoy,\n    vencidasEnRevisionesAnteriores: vencidasAnterior,\n    tendencia\n  }\n}];\n"
      },
