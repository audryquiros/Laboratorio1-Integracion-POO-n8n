      "name": "Consultar feriados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        240
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const facturasRaw = $('Obtener facturas pendientes').all().map(x => x.json);\nconst feriadosRaw = $('Consultar feriados').all().map(x => x.json);\nconst feriados = new Set(feriadosRaw.map(x => x.date).filter(Boolean));\nconst hoy = new Date().toISOString().slice(0, 10);\n\nfunction esHabil(iso) {\n  const d = new Date(`${iso}T12:00:00Z`);\n  return d.getUTCDay() !== 0 && d.getUTCDay() !== 6 && !feriados.has(iso);\n}\nfunction sumarDiasHabiles(inicio, cantidad) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(inicio)) throw new Error('Fecha de emisión ausente o inválida (YYYY-MM-DD).');\n  if (!Number.isInteger(Number(cantidad)) || Number(cantidad) < 1) throw new Error('diasPlazo debe ser entero positivo.');\n  const d = new Date(`${inicio}T12:00:00Z`);\n  let n = 0, guardia = 0;\n  while (n < Number(cantidad)) {\n    d.setUTCDate(d.getUTCDate() + 1);\n    const iso = d.toISOString().slice(0,10);\n    if (esHabil(iso)) n++;\n    if (++guardia > 800) throw new Error('Límite de cálculo excedido.');\n  }\n  return d.toISOString().slice(0,10);\n}\nconst resultado = [];\nfor (const f of facturasRaw) {\n  try {\n    if (f.id === undefined || !f.cliente || !f.fechaEmision) throw new Error('Faltan id, cliente o fechaEmision.');\n    const vencimiento = sumarDiasHabiles(f.fechaEmision, f.diasPlazo ?? 15);\n    const estado = ['pagada','anulada'].includes(String(f.estado).toLowerCase())\n      ? String(f.estado).toLowerCase()\n      : (hoy > vencimiento ? 'vencida' : 'pendiente');\n    resultado.push({json:{...f, fechaVencimiento:vencimiento, estadoCalculado:estado, fechaProceso:hoy, error:null}});\n  } catch (e) {\n    resultado.push({json:{...f, estadoCalculado:'error', error:e.message, fechaProceso:hoy}});\n  }\n}\nreturn resultado;"
      },
      "id": "business-logic",
      "name": "Calcular vencimientos (POO)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
